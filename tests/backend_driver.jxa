// Runs the real backend/Code.gs against an in-memory fake of Google Sheets (macOS, from the repo root):  osascript -l JavaScript tests/backend_driver.jxa
ObjC.import('Foundation');
const rd = p => ObjC.unwrap($.NSString.stringWithContentsOfFileEncodingError(p, 4, $()));
const CODE = rd('backend/Code.gs'), TESTS = rd('tests/backend_tests.js');
let uuid = 0, fetches = 0, mails = 0;
function MockSheet(name) { this.name = name; this.data = []; }
MockSheet.prototype = {
  getLastRow() { return this.data.length; },
  getLastColumn() { return this.data.reduce((m, r) => Math.max(m, r.length), 0); },
  getRange(r, c, nr, nc) {
    const sh = this; nr = nr || 1; nc = nc || 1;
    return {
      getValues() { const out = []; for (let i = 0; i < nr; i++) { const row = []; for (let j = 0; j < nc; j++) { const v = (sh.data[r - 1 + i] || [])[c - 1 + j]; row.push(v === undefined ? '' : v); } out.push(row); } return out; },
      setValues(vals) { for (let i = 0; i < vals.length; i++) { sh.data[r - 1 + i] = sh.data[r - 1 + i] || []; for (let j = 0; j < vals[i].length; j++) sh.data[r - 1 + i][c - 1 + j] = vals[i][j]; } },
      setNumberFormat() {}, setValue(v) { sh.data[r - 1] = sh.data[r - 1] || []; sh.data[r - 1][c - 1] = v; }
    };
  },
  getDataRange() { const w = this.getLastColumn(), d = this.data; return { getValues: () => d.map(r => { const x = r.slice(); while (x.length < w) x.push(''); return x; }) }; },
  appendRow(row) { this.data.push(row.slice()); }, deleteRow(n) { this.data.splice(n - 1, 1); }, deleteRows(n, k) { this.data.splice(n - 1, k); }, setFrozenRows() {}
};
const sheets = {};
const mocks = {
  SpreadsheetApp: { getActiveSpreadsheet: () => ({ getSheetByName: n => sheets[n] || null, insertSheet: n => (sheets[n] = new MockSheet(n)) }) },
  PropertiesService: { getScriptProperties: () => ({ getProperty: k => ({ ADMIN_EMAIL: 'admin@example.com', ADMIN_PASSWORD: 'pw', SESSION_SECRET: 's' }[k] || null) }) },
  LockService: { getScriptLock: () => ({ waitLock() {}, releaseLock() {} }) },
  Utilities: { getUuid: () => 'id-' + (++uuid), computeHmacSha256Signature: () => [1, 2, 3] },
  UrlFetchApp: { fetch() { fetches++; return { getContentText: () => '{}' }; } },
  MailApp: { sendEmail() { mails++; } },
  ContentService: { createTextOutput: s => ({ setMimeType: () => s }), MimeType: { JSON: 'json' } },
  M: { sheets: sheets, fetches: () => fetches, mails: () => mails }
};
const names = Object.keys(mocks);
const f = new Function(...names, CODE + '\n' + TESTS + '\nreturn tests(M);');
f(...names.map(n => mocks[n]));
